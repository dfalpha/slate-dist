# Host-local deployment values (issue 0.9). Copy to .env on each host and
# fill in real values - .env is git-ignored, never commit real secrets here.
#
# THIS FILE IS PUBLISHED. It is mirrored to github.com/dfalpha/slate-dist so
# an installer can fetch it, so it carries no address, machine name or setting
# belonging to any particular install - including ours. The table of our own
# hosts that used to live here is in infra/README.md, which is not mirrored.
#
# ############################################################################
# #  ONE NAME. THE OLD ONES ARE NOT SERVED.                                  #
# #                                                                          #
# #  Owner's call, 2026-09-09: the tablets get reset rather than the         #
# #  hostnames carried in parallel. So this is a clean cut, not an additive  #
# #  move, and it comes with a cost that is already accepted and is written  #
# #  here only so nobody rediscovers it in a panic.                          #
# #                                                                          #
# #  WHAT HAPPENS TO A TABLET WHEN THE OLD NAME STOPS ANSWERING: nothing     #
# #  useful. `DeviceIdScreen` - the only screen that accepts a server        #
# #  address - renders only when the stored token is null, and the escape    #
# #  hatch back to enrolment fires on an HTTP 401, which a dead hostname     #
# #  never produces. It produces a DNS failure, so the tablet never reaches  #
# #  a server, never sees a 401, and never offers the field again.           #
# #                                                                          #
# #  THE RECOVERY, PER TABLET: Settings -> Apps -> Slate -> Storage ->       #
# #  Clear data, then re-enrol on the new address. That also drops the       #
# #  device identity, so each of the six comes back as a new device and      #
# #  needs its role and dashboard assigned again.                            #
# #                                                                          #
# #  Do all six in one sitting. A half-migrated wall is the worst state:     #
# #  some panels live, some showing a connection error with no way in.       #
# ############################################################################
#
# The staging host runs the server-staging service (stub integrations), not
# server - see infra/README.md - so its SLATE_UPSTREAM differs from the
# other two hosts.
#
# On a host's dedicated Linux VM (issue 0.12, infra/docker-compose.host-network.yml -
# see infra/README.md's "Dedicated Linux VM" section), server/server-staging
# and caddy share the VM's own host network namespace instead of the compose
# bridge network, so SLATE_UPSTREAM becomes localhost:8080 there regardless
# of host - the same value on all three once each one has moved.
#
# The dev host also needs infra/docker-compose.dev.yml layered on top - it
# repoints `server` at the :latest tag instead of :production, so dev tracks
# the newest merged build (with real, non-stub integrations) rather than
# whatever's been deliberately promoted to production. See that file and
# infra/README.md's dev host section.

# ############################################################################
#  TLS. THE PORTAL ISSUES CERTIFICATES; THIS MACHINE HOLDS NO DNS CREDENTIAL.
#
#  CLOUDFLARE_API_TOKEN USED TO LIVE HERE AND MUST NOT COME BACK. A Cloudflare
#  token scopes to a ZONE, not a record, so a token on this machine could
#  obtain a certificate for another household's install or repoint their
#  address. That is cross-tenant impersonation available to every customer, by
#  design, and there is no careful-with-it version that is safe.
#
#  Instead: the server generates its own keypair, sends a certificate signing
#  request to the portal at check-in, and writes back the chain. THE PRIVATE
#  KEY NEVER LEAVES THIS MACHINE.
#
#  Leave the URL empty and none of this happens -- Caddy then has no
#  certificate to serve and will not start, while the server's direct :8080
#  HTTP access carries on unaffected.
# ############################################################################
SLATE_PORTAL_CHECKIN_URL=https://portal.slatepanel.app/install/check-in

# Twice a day. Two chances to notice this machine's address has changed, and a
# certificate is only requested when one is actually due -- every check-in
# asking for one would burn Let's Encrypt's per-domain weekly limit, which is
# shared with every other customer.
SLATE_PORTAL_CHECKIN_HOURS=12

# ############################################################################
#  THE PORTAL'S ORIGIN, for licensing this server without handling a key.
#
#  With this set, the Licence tab offers "Link to my Slate account": the server
#  asks the portal for a short code, shows it, and the customer types it at the
#  portal and picks which install this machine is. The licence then arrives
#  here on its own. Nobody copies, pastes or emails a credential.
#
#  The portal password NEVER reaches this machine. The obvious alternative -- a
#  sign-in form here that posts the customer's portal credentials onward --
#  would put it on the very server the exchange exists to authenticate, so a
#  compromised install would harvest portal logins. This is RFC 8628's device
#  authorization grant for exactly that reason.
#
#  Nothing here opens an inbound path: this server polls outward, and the admin
#  panel polls this server. Leave it empty and the Licence tab simply says no
#  portal is configured; a licence can still be pasted in by hand, which is the
#  right answer for an install with no route out.
#
#  An ORIGIN, not an endpoint -- a path here would produce URLs nobody meant.
# ############################################################################
SLATE_PORTAL_URL=https://portal.slatepanel.app

# What this install calls itself. Sent to the portal when starting a link, and
# it is a CLAIM in the strict sense: nothing has authenticated this server at
# that point, which is what the exchange is for. The portal shows it to the
# approving customer clearly labelled as self-reported, so its only job is to
# help them recognise the machine in front of them. Safe to leave empty.
SLATE_INSTALL_HOSTNAME=

# OTHER NAMES THIS INSTALL STILL ANSWERS TO. Empty except during a migration.
#
# A tablet is enrolled against whatever hostname it was given and CANNOT be
# repointed remotely, so renaming an install strands every tablet in the house
# until somebody walks round and re-enrols each one. Both names are served
# until the last tablet has moved, which means the certificate must cover
# both -- that is what this list is for.
#
# The portal must ALSO list the name in its own allowlist. This says "serve
# it"; that says "we are permitted to certify it".
SLATE_LEGACY_HOSTNAMES=

# ############################################################################
#  THE NAME THIS INSTALL SERVES OVER HTTPS. YOU ALMOST CERTAINLY WANT IT EMPTY.
#
#  This is a MANUAL OVERRIDE, not the normal path. An install that has linked
#  its account learns its own hostname from the signed licence and sets HTTPS
#  up on its own - nobody edits this file, and nobody restarts anything.
#
#  EMPTY, WHICH IS THE NORMAL STATE: the stack starts in full, Caddy included.
#  Caddy comes up on a bootstrap config that names no site; the SERVER pushes
#  it one over Caddy's admin API once a name and a certificate exist. Reach the
#  admin panel meanwhile at http://<this machine's LAN address>:8080 and link
#  the account from the Licence tab - that is what produces the name.
#
#  SET: this value wins over the licence. It is read by the server, not by
#  Caddy, so it takes effect at the next check-in rather than needing the stack
#  brought up again. It is for the case the licence cannot cover - a name of
#  your own, or a migration - and for nothing else.
#
#  DO NOT INVENT A NAME. The certificate is issued for the name the portal
#  knows; a name it does not know gets no certificate, and HTTPS then fails on
#  a setting somebody typed rather than on anything being broken.
# ############################################################################
SLATE_HOSTNAME=
SLATE_UPSTREAM=server:8080

# ---- Server bootstrap (issue 0.8) ----
# Needed for the very first admin login as the reserved `admin` username.
#
# THE ONE VALUE AN INSTALLER ASKS FOR. Everything else in this file is either
# legitimately empty or ships a correct default, so the Linux installer prompts
# for this alone and the Windows installer collects it on a wizard page. It is
# the only setting a person could not be handed.
#
# From the Users tab (issue 2.13), `admin`'s password can be changed via a
# "Change Password" popup like any other account - once that's done, this
# env value stops working until the break-glass flag below clears the
# override. Named admin accounts (issue 0.13) are unaffected either way.
SLATE_ADMIN_PASSWORD=

# ---- Admin password break-glass reset (issue 2.13) ----
# Set to "true" and restart the container to clear a stored `admin` password
# override, falling back to SLATE_ADMIN_PASSWORD above. Unset it again (or
# set back to "false") once logged back in, or every subsequent restart will
# keep clearing any new override set from the panel. See infra/README.md.
SLATE_RESET_ADMIN_PASSWORD=false

# ---- Doorbell video, bridge networking only (backlog 5.8 Phase 2) ----
# The mediamtx sidecar fans the doorbell feed out to the tablets over WebRTC,
# which means handing them ICE candidates they can actually reach. On the
# compose bridge network the container's own IP is not one, so set this to the
# host's LAN address (the one `ip addr` shows for your real interface).
#
# LEAVE THIS BLANK on a host running infra/docker-compose.host-network.yml -
# which is the supported deployment for doorbell video. There, mediamtx sees
# the real LAN interface and works this out on its own.
SLATE_HOST_LAN_IP=

# ---- Watchtower poll interval (issue 0.11) ----
# Optional - defaults to 300 (5 min) if unset. Production stays deliberate
# via `server` tracking a manually-promoted :production tag (see "Promote
# Server Build to Production" in infra/README.md), not via this interval -
# so it's safe to tighten on both hosts. Recommended: 60 on staging, 180 on
# production - at this scale (a couple of hosts, two images each) that's
# nowhere near any GHCR rate limit.
WATCHTOWER_POLL_INTERVAL=
